diff --git a/.github/workflows/size-cap.yml b/.github/workflows/size-cap.yml
new file mode 100644
index 0000000..5f4692a
--- /dev/null
+++ b/.github/workflows/size-cap.yml
@@ -0,0 +1,54 @@
+name: Size cap
+
+# Fails the caller's CI when a hand-written file is over the Size cap and its Over-cap list does not
+# hold it, or when the list breaks one of its rules. All of the logic is size-cap/size-cap.mjs; the
+# caller's `.gitattributes` marks the files it exempts, and its `.over-cap-list` lists the rest.
+
+on:
+  workflow_call:
+
+jobs:
+  size-cap:
+    name: size cap
+    # ubuntu-slim, since the job is thin; workflow-policy/slim-jobs.test.mjs holds it to slim's limits.
+    runs-on: ubuntu-slim
+    timeout-minutes: 10
+    permissions:
+      contents: read
+
+    steps:
+      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
+        with:
+          path: repo
+          # The whole history, so the base below is a commit the check can read, however far back
+          # a pull request's base or a push's previous tip is.
+          fetch-depth: 0
+          persist-credentials: false
+
+      # The check from the commit this workflow file was called at, whatever ref the caller
+      # names, so the two never come from different commits.
+      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
+        with:
+          repository: filiptrivan/ci-workflows
+          ref: ${{ job.workflow_sha }}
+          path: checker
+          persist-credentials: false
+
+      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6.5.0
+        with:
+          node-version: 22
+
+      - name: Judge every tracked file, and the Over-cap list against the base
+        working-directory: repo
+        env:
+          BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}
+        run: |
+          # A branch's first push names an all-zero previous tip, and a force push one that is no
+          # longer in history: the run then judges every file and line but counts no line as added,
+          # which the branch's pull request judges against its base.
+          if [ -n "$BASE" ] && git cat-file -e "$BASE^{commit}" 2>/dev/null; then
+            node ../checker/size-cap/size-cap.mjs --base "$BASE"
+          else
+            echo "::notice::no base commit to compare the Over-cap list with; the pull request's run judges its added lines"
+            node ../checker/size-cap/size-cap.mjs
+          fi
